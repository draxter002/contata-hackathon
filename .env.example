# TaskFlow Pro — Root Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the actual .env file.

# ─── Backend (api/.env) ───────────────────────────────────────────────────────
# Anthropic API key — required only for the AI suggestion feature.
# The app runs normally without it; /ai/suggest-dependencies returns a clear error.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Database connection string.
# Leave blank to use SQLite (local dev, zero setup).
# Set to a PostgreSQL URL for deployment: postgresql://user:pass@host:5432/taskflow
DATABASE_URL=

# Allowed frontend origin for CORS (production only).
# In dev, localhost:3000 is allowed automatically.
ALLOWED_ORIGIN=http://localhost:3000

# ─── Frontend (web/.env.local) ────────────────────────────────────────────────
# URL of the running backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000
